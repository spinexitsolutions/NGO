# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the website (used in emails, receipts, sitemap, CORS)
PUBLIC_SITE_URL=http://localhost:5173
# MongoDB connection. The default is the private MongoDB that `npm run local` starts for you (data in
# server/data/mongo). For MongoDB Atlas or your own server, paste its URL here; it must be a replica set
# (Atlas always is). Example: mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/ngo?retryWrites=true&w=majority
DATABASE_URL="mongodb://127.0.0.1:27027/ngo?replicaSet=rs0&directConnection=true"
# 32+ random characters. Used to encrypt MFA secrets and sign tokens. `openssl rand -hex 32`
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Set to true when served over HTTPS (secure cookies)
COOKIE_SECURE=false
# Comma-separated list of extra allowed CORS origins (only needed if the client is on another origin)
CORS_ORIGINS=

# ── Payments ────────────────────────────────────────────────────────
# "sandbox" simulates checkout locally (no money moves). Use "razorpay" with test keys first.
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email ───────────────────────────────────────────────────────────
# "log" prints emails to the server log (development). "smtp" works with Resend, SendGrid, SES, Postmark...
EMAIL_TRANSPORT=log
EMAIL_FROM="Saathi Foundation <no-reply@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where admin alerts are sent (optional)
ADMIN_ALERT_EMAIL=

# ── Media storage ───────────────────────────────────────────────────
# "local" stores files in ./uploads (development only). Use "cloudinary" in production.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=15

# ── Jobs ────────────────────────────────────────────────────────────
JOBS_ENABLED=true
